digraph MatrizDispersa {
    labelloc="t";
    label="Matriz Dispersa (Lista Enlazada Ortogonal)";
    fontsize=16;
    fontname="Arial Bold";
    nodesep=0.6;
    ranksep=0.7;

    node [shape=box, style=filled, fontname="Arial", fontsize=11];
    edge [fontcolor=black, fontsize=9];

    origen [label="fila/columna", fontsize=10, fillcolor=white];

    // Cabeceras de columna (generos)
    cab_col_0 [label="Drama\n(col 0)", group=1, fillcolor="#2980b9", fontcolor=white];
    cab_col_1 [label="Thriller\n(col 1)", group=2, fillcolor="#2980b9", fontcolor=white];
    cab_col_2 [label="Ciencia Ficcion\n(col 2)", group=3, fillcolor="#2980b9", fontcolor=white];
    cab_col_3 [label="Fantasia\n(col 3)", group=4, fillcolor="#2980b9", fontcolor=white];
    cab_col_4 [label="Accion\n(col 4)", group=5, fillcolor="#2980b9", fontcolor=white];
    cab_col_5 [label="Comedia\n(col 5)", group=6, fillcolor="#2980b9", fontcolor=white];

    //  Cabeceras de fila (directores) 
    cab_fil_0 [label="Francis Ford Coppola\n(fil 0)", group=0, fillcolor="#27ae60", fontcolor=white];
    cab_fil_1 [label="Quentin Tarantino\n(fil 1)", group=0, fillcolor="#27ae60", fontcolor=white];
    cab_fil_2 [label="Christopher Nolan\n(fil 2)", group=0, fillcolor="#27ae60", fontcolor=white];
    cab_fil_3 [label="Peter Jackson\n(fil 3)", group=0, fillcolor="#27ae60", fontcolor=white];

    // Nodos dato (peliculas) 
    dato_0_0 [label="(0,0)\npelica3\n2888 | 35min", group=1, fillcolor="#ecf0f1"];
    dato_0_5 [label="(0,5)\npeli2\n2555 | 23min", group=6, fillcolor="#ecf0f1"];
    dato_1_4 [label="(1,4)\npelicula8\n200 | 150min", group=5, fillcolor="#ecf0f1"];
    dato_2_3 [label="(2,3)\npeli5\n2000 | 43min", group=4, fillcolor="#ecf0f1"];
    dato_3_5 [label="(3,5)\npeli6\n12 | 12min", group=6, fillcolor="#ecf0f1"];

    // Punteros horizontales: derecha / izquierda
    cab_fil_0 -> dato_0_0 [dir=both, color="#27ae60"];
    dato_0_0 -> dato_0_5 [dir=both, color="#27ae60"];
    cab_fil_1 -> dato_1_4 [dir=both, color="#27ae60"];
    cab_fil_2 -> dato_2_3 [dir=both, color="#27ae60"];
    cab_fil_3 -> dato_3_5 [dir=both, color="#27ae60"];

    // Punteros verticales: arriba / abajo
    cab_col_0 -> dato_0_0 [dir=both, color="#2980b9"];
    cab_col_3 -> dato_2_3 [dir=both, color="#2980b9"];
    cab_col_4 -> dato_1_4 [dir=both, color="#2980b9"];
    cab_col_5 -> dato_0_5 [dir=both, color="#2980b9"];
    dato_0_5 -> dato_3_5 [dir=both, color="#2980b9"];

    // Punteros siguiente/anterior entre cabeceras de columna
    cab_col_0 -> cab_col_1 [dir=both, color="#8e44ad", style=dashed, constraint=false];
    cab_col_1 -> cab_col_2 [dir=both, color="#8e44ad", style=dashed, constraint=false];
    cab_col_2 -> cab_col_3 [dir=both, color="#8e44ad", style=dashed, constraint=false];
    cab_col_3 -> cab_col_4 [dir=both, color="#8e44ad", style=dashed, constraint=false];
    cab_col_4 -> cab_col_5 [dir=both, color="#8e44ad", style=dashed, constraint=false];

    // Punteros siguiente/anterior entre cabeceras de fila
    cab_fil_0 -> cab_fil_1 [dir=both, color="#8e44ad", style=dashed, constraint=false];
    cab_fil_1 -> cab_fil_2 [dir=both, color="#8e44ad", style=dashed, constraint=false];
    cab_fil_2 -> cab_fil_3 [dir=both, color="#8e44ad", style=dashed, constraint=false];

    //  Alineacion visual
    { rank=same; origen; cab_col_0; cab_col_1; cab_col_2; cab_col_3; cab_col_4; cab_col_5; }
    { rank=same; cab_fil_0; dato_0_0; dato_0_5; }
    { rank=same; cab_fil_1; dato_1_4; }
    { rank=same; cab_fil_2; dato_2_3; }
    { rank=same; cab_fil_3; dato_3_5; }

    origen -> cab_col_0 [style=invis];
    cab_col_0 -> cab_col_1 [style=invis];
    cab_col_1 -> cab_col_2 [style=invis];
    cab_col_2 -> cab_col_3 [style=invis];
    cab_col_3 -> cab_col_4 [style=invis];
    cab_col_4 -> cab_col_5 [style=invis];
    origen -> cab_fil_0 [style=invis];
    cab_fil_0 -> cab_fil_1 [style=invis];
    cab_fil_1 -> cab_fil_2 [style=invis];
    cab_fil_2 -> cab_fil_3 [style=invis];
}
