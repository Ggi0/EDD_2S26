####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/ejemplo2/bin || mkdir -p $(INSTALL_ROOT)/opt/ejemplo2/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/ejemplo2/bin/ejemplo2.app
	
	$(QINSTALL) ejemplo2.app $(INSTALL_ROOT)/opt/ejemplo2/bin/ejemplo2.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/ejemplo2/bin/ejemplo2.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/ejemplo2/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

