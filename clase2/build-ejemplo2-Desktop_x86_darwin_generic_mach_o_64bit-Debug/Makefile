	@$(DEL_FILE) ejemplo2.app/Contents/PkgInfo
	@echo "APPL????" > ejemplo2.app/Contents/PkgInfo
ejemplo2.app/Contents/Resources/empty.lproj: 
	@test -d ejemplo2.app/Contents/Resources || mkdir -p ejemplo2.app/Contents/Resources
	@touch ejemplo2.app/Contents/Resources/empty.lproj
	
ejemplo2.app/Contents/Info.plist: 
	@test -d ejemplo2.app/Contents || mkdir -p ejemplo2.app/Contents
	@$(DEL_FILE) ejemplo2.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.ejemplo2,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.ejemplo2,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,ejemplo2,g" -e "s,@LIBRARY@,ejemplo2,g" -e "s,\$${EXECUTABLE_NAME},ejemplo2,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" /Users/gio/Desktop/qt/qt-everywhere-src-5.15.2/qtbase/mkspecs/macx-clang/Info.plist.app >ejemplo2.app/Contents/Info.plist

